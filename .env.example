# A label shown as a badge in the UI and in the macOS app's name.
# The code makes no decisions based on it.
INSTANCE_ENV_NAME=dev

# macOS app (make app): 1 — live in the menu bar and leave the Dock when the
# window closes, 0 — a regular window in the Dock.
MENU_BAR_ICON=0

# Ports of the app and the AI proxy.
PORT=17832
AI_PROXY_PORT=8766

# Ports for development worktrees. All worktrees share one pair of ports,
# so only one runs at a time. They must differ from PORT and AI_PROXY_PORT.
WORKTREE_PORT=17840
WORKTREE_AI_PROXY_PORT=8770

# Required. Absolute path to an existing folder with the dictionary data;
# an empty folder works too. See docs/reference/dictionaries.md.
DICTIONARIES_DIR=
